NODE_ENV=production
PORT=3001
# Local development uses DATABASE_PATH. Render UAT uses DATABASE_URL instead.
DATABASE_PATH=./data/hospital.sqlite
DATABASE_URL=
PYTHON_AGENT_URL=http://localhost:8000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Stable key used to encrypt per-clinic provider credentials at rest. Keep it
# unchanged across restarts and backups; generate a random value of 32+ chars.
CREDENTIALS_ENCRYPTION_KEY=replace-with-a-separate-random-secret-at-least-32-characters
# Optional: set both values to enable super-admin login.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Optional: defaults to the Render landing page origin.
CORS_ORIGINS=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# Configure these callback Basic Auth credentials with Exotel Support, then use
# the HTTPS webhook endpoint documented in VOICE_RECEPTIONIST.md. Keep unique.
EXOTEL_VOICEBOT_WEBHOOK_USERNAME=
EXOTEL_VOICEBOT_WEBHOOK_PASSWORD=
SARVAM_API_KEY=
# Generate a random value with at least 32 characters. Clinic-specific
# derived secrets are returned to Super Admin after each clinic's settings save.
VOICE_TOOL_SECRET=
