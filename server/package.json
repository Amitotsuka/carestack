{
  "name": "hospital-node-api",
  "version": "1.0.0",
  "description": "NestJS service layer for the Hospital Agent Portal",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "export:sqlite-state": "node scripts/export-sqlite-state.cjs",
    "import:postgres-state": "node scripts/import-state-to-postgres.cjs",
    "lint": "echo 'No lint configured'",
    "test": "tsc -p tsconfig.json && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.1.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^18.0.7",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "rimraf": "^6.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
