{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "const": "book",
      "description": "Required constant action."
    },
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Stable unique idempotency key for this booking request. Reuse it on retries."
    },
    "confirmed": {
      "type": "boolean",
      "const": true,
      "description": "Must be true only after the caller confirms the read-back appointment details."
    },
    "patient_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120,
      "description": "Caller-provided patient name."
    },
    "phone_number": {
      "type": "string",
      "description": "Caller-confirmed reachable phone number."
    },
    "doctor_name": {
      "type": "string",
      "description": "Exact doctor name returned by clinic_info or availability."
    },
    "date": {
      "type": "string",
      "description": "Appointment date; use YYYY-MM-DD."
    },
    "time": {
      "type": "string",
      "description": "Appointment time in 24-hour HH:mm format."
    },
    "reason": {
      "type": "string",
      "maxLength": 500,
      "description": "Optional caller-provided visit reason. Omit if the caller did not provide one; never invent a reason."
    }
  },
  "required": ["action", "request_id", "confirmed", "patient_name", "phone_number", "doctor_name", "date", "time"],
  "additionalProperties": false
}
